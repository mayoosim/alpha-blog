<div class="container">
  <div class="row justify-content-center mt-3">
    <div class="col-8">
      <%= render 'shared/errors' %>
      <%= form_with(model: @article, class:"shadow p-3 mb-3 bg-info rounded", local: true) do |f| %>
        <div class="form-group row">
          <%= f.label :title, class: "col-sm-2 col-form-label text-light" %>
          <div class="col-sm-10 text-center">
            <%= f.text_field :title, class: "form-control shadow rounded", placeholder: "Title" %>
          </div>
        </div>
        <div class="form-group row">
          <%= f.label :description, class: "col-sm-2 col-form-label text-light" %>
          <div class="col-sm-10 text-center mt-2">
            <%= f.text_area :description, rows: 5, class: "form-control shadow rounded", placeholder: "Description" %>
          </div>
        </div>
        <div class="form-group row justify-content-center">
          <div class="col-sm-10 text-center mt-3">
            <%= f.submit class: "btn btn-outline-light btn-lg" %>
          </div>
        </div>
      <% end %>
    </div>
      <%= link_to '[Cancel Editing and go to listing]', articles_path, class:"text-info text-center" %>
  </div>
</div>